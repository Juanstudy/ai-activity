pkgname=ai-activity
pkgver=0.1.0
pkgrel=1
pkgdesc='Monitor AI usage on your laptop across time ranges, costs in USD and COP, and activity heatmap'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/ai-activity "$pkgdir/usr/bin/ai-activity"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/ai-activity.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/ai-activity.svg"
  install -Dm644 "$startdir/ai-activity.desktop" "$pkgdir/usr/share/applications/ai-activity.desktop"
}
